#!/usr/bin/env python3

import os
import cv2
import numpy as np


EPS = 1e-8


# ============================================================
# IMAGE I/O
# ============================================================

def read_image(path):

    image = cv2.imread(
        path,
        cv2.IMREAD_COLOR
    )

    if image is None:
        raise FileNotFoundError(
            f"Could not read image:\n{path}"
        )

    return (
        image.astype(np.float32)
        / 255.0
    )


# ============================================================
# LUMINANCE
# ============================================================

def luminance(image):

    return (
        0.0722 * image[:, :, 0]
        + 0.7152 * image[:, :, 1]
        + 0.2126 * image[:, :, 2]
    ).astype(np.float32)


# ============================================================
# SCENE STATISTICS
# ============================================================

def scene_statistics(image):

    lum = luminance(image)

    return {
        "mean": float(np.mean(lum)),
        "median": float(np.median(lum)),
        "p10": float(np.percentile(lum, 10)),
        "p25": float(np.percentile(lum, 25)),
        "p75": float(np.percentile(lum, 75)),
        "p90": float(np.percentile(lum, 90)),
        "shadow_ratio": float(np.mean(lum < 0.30)),
        "deep_shadow_ratio": float(np.mean(lum < 0.18)),
        "highlight_ratio": float(np.mean(lum > 0.85)),
        "clipped_ratio": float(np.mean(lum > 0.99)),
    }


# ============================================================
# NATURAL BRIGHTNESS SCORE
# ============================================================

def brightness_score(
    candidate,
    normal
):
    """
    Prefer natural brightness.

    Rules:
        - Near-normal brightness = strong score.
        - Slightly brighter = acceptable / preferred.
        - Much brighter = strongly penalized.
        - Slightly darker = acceptable.
    """

    candidate_lum = luminance(
        candidate
    )

    normal_lum = luminance(
        normal
    )

    normal_mean = float(
        np.mean(normal_lum)
    )

    candidate_mean = float(
        np.mean(candidate_lum)
    )

    delta = (
        candidate_mean -
        normal_mean
    )

    # --------------------------------------------------------
    # Small brightness envelope.
    #
    # We do NOT force a fixed +8% target.
    # --------------------------------------------------------

    preferred_lift = 0.02
    acceptable_lift = 0.06
    hard_lift = 0.12

    if delta < 0.0:

        # Slight darkening is tolerated.
        score = np.exp(
            -abs(delta) * 4.0
        )

    elif delta <= preferred_lift:

        # Around normal / slightly brighter.
        score = 1.0

    elif delta <= acceptable_lift:

        # Gradually reduce score.
        excess = (
            delta -
            preferred_lift
        )

        score = np.exp(
            -excess * 12.0
        )

    else:

        # Strong penalty for excessive brightness.
        excess = (
            delta -
            acceptable_lift
        )

        score = (
            np.exp(
                -excess * 25.0
            )
        )

        # Hard protection beyond an extreme lift.
        if delta >= hard_lift:
            score *= 0.35

    return float(
        np.clip(
            score,
            0.0,
            1.0
        )
    )


# ============================================================
# SHADOW NATURALNESS
# ============================================================

def shadow_score(
    candidate,
    normal
):
    """
    Evaluate whether shadows are being recovered naturally.

    We want useful recovery, not blanket shadow lifting.
    """

    candidate_lum = luminance(
        candidate
    )

    normal_lum = luminance(
        normal
    )

    shadow_mask = (
        normal_lum < 0.30
    )

    if not np.any(shadow_mask):
        return 1.0

    normal_shadow = (
        normal_lum[
            shadow_mask
        ]
    )

    candidate_shadow = (
        candidate_lum[
            shadow_mask
        ]
    )

    recovery = float(
        np.mean(
            candidate_shadow -
            normal_shadow
        )
    )

    # --------------------------------------------------------
    # Scene-adaptive desired recovery.
    #
    # Very deep scenes can tolerate more recovery.
    # --------------------------------------------------------

    deep_ratio = float(
        np.mean(
            normal_lum < 0.18
        )
    )

    desired_recovery = (
        0.025 +
        0.10 * deep_ratio
    )

    error = abs(
        recovery -
        desired_recovery
    )

    score = np.exp(
        -error * 18.0
    )

    # Excessive global shadow lifting gets another penalty.
    if recovery > 0.12:

        score *= 0.50

    if recovery > 0.18:

        score *= 0.25

    return float(
        np.clip(
            score,
            0.0,
            1.0
        )
    )


# ============================================================
# HIGHLIGHT PROTECTION
# ============================================================

def highlight_score(
    candidate,
    normal
):

    candidate_lum = luminance(
        candidate
    )

    normal_lum = luminance(
        normal
    )

    highlight_mask = (
        normal_lum > 0.88
    )

    if not np.any(
        highlight_mask
    ):
        return 1.0

    candidate_highlights = (
        candidate_lum[
            highlight_mask
        ]
    )

    clipped_ratio = float(
        np.mean(
            candidate_highlights >
            0.99
        )
    )

    # Penalize new clipping.
    score = (
        1.0 -
        clipped_ratio
    )

    # Also penalize pushing highlights substantially
    # brighter than their normal-exposure values.
    normal_highlights = (
        normal_lum[
            highlight_mask
        ]
    )

    highlight_lift = float(
        np.mean(
            candidate_highlights -
            normal_highlights
        )
    )

    if highlight_lift > 0.08:

        score *= 0.70

    if highlight_lift > 0.15:

        score *= 0.40

    return float(
        np.clip(
            score,
            0.0,
            1.0
        )
    )


# ============================================================
# COLOR FIDELITY
# ============================================================

def color_score(
    candidate,
    normal
):
    """
    Compare chromatic behavior against Normal.
    """

    candidate_mean = np.mean(
        candidate,
        axis=(0, 1)
    )

    normal_mean = np.mean(
        normal,
        axis=(0, 1)
    )

    mean_error = float(
        np.mean(
            np.abs(
                candidate_mean -
                normal_mean
            )
        )
    )

    # Compare channel ratios too.
    candidate_std = np.std(
        candidate,
        axis=(0, 1)
    )

    normal_std = np.std(
        normal,
        axis=(0, 1)
    )

    std_error = float(
        np.mean(
            np.abs(
                candidate_std -
                normal_std
            )
        )
    )

    score_mean = np.exp(
        -mean_error * 12.0
    )

    score_std = np.exp(
        -std_error * 12.0
    )

    score = (
        0.65 * score_mean
        +
        0.35 * score_std
    )

    return float(
        np.clip(
            score,
            0.0,
            1.0
        )
    )


# ============================================================
# STRUCTURE SCORE
# ============================================================

def structure_score(
    candidate,
    normal
):

    candidate_lum = (
        luminance(candidate) * 255.0
    ).astype(
        np.uint8
    )

    normal_lum = (
        luminance(normal) * 255.0
    ).astype(
        np.uint8
    )

    candidate_edges = cv2.Canny(
        candidate_lum,
        50,
        150
    )

    normal_edges = cv2.Canny(
        normal_lum,
        50,
        150
    )

    difference = float(
        np.mean(
            np.abs(
                candidate_edges.astype(
                    np.float32
                )
                -
                normal_edges.astype(
                    np.float32
                )
            )
        )
        / 255.0
    )

    return float(
        np.clip(
            1.0 - difference,
            0.0,
            1.0
        )
    )


# ============================================================
# NATURALNESS PENALTY
# ============================================================

def artificial_lift_penalty(
    candidate,
    normal
):

    candidate_lum = luminance(
        candidate
    )

    normal_lum = luminance(
        normal
    )

    # Regions that are moderately dark in Normal.
    mask = (
        (normal_lum >= 0.10)
        &
        (normal_lum < 0.35)
    )

    if not np.any(mask):
        return 0.0

    lift = float(
        np.mean(
            candidate_lum[mask]
            -
            normal_lum[mask]
        )
    )

    # Only penalize excessive lift.
    penalty = max(
        0.0,
        lift - 0.06
    )

    return float(
        np.clip(
            penalty * 5.0,
            0.0,
            1.0
        )
    )


# ============================================================
# COMPLETE EVALUATION
# ============================================================

def evaluate(
    candidate_path,
    normal_path
):

    candidate = read_image(
        candidate_path
    )

    normal = read_image(
        normal_path
    )

    # --------------------------------------------------------
    # Match size if necessary.
    # --------------------------------------------------------

    if candidate.shape[:2] != normal.shape[:2]:

        candidate = cv2.resize(
            candidate,
            (
                normal.shape[1],
                normal.shape[0]
            ),
            interpolation=cv2.INTER_AREA
        )

    scores = {}

    scores["brightness"] = (
        brightness_score(
            candidate,
            normal
        )
    )

    scores["shadow"] = (
        shadow_score(
            candidate,
            normal
        )
    )

    scores["highlight"] = (
        highlight_score(
            candidate,
            normal
        )
    )

    scores["color"] = (
        color_score(
            candidate,
            normal
        )
    )

    scores["structure"] = (
        structure_score(
            candidate,
            normal
        )
    )

    scores["artificial_lift"] = (
        artificial_lift_penalty(
            candidate,
            normal
        )
    )

    # --------------------------------------------------------
    # Final weighted score
    # --------------------------------------------------------

    base_score = (

        0.28 *
        scores["brightness"]

        +

        0.22 *
        scores["shadow"]

        +

        0.18 *
        scores["highlight"]

        +

        0.14 *
        scores["color"]

        +

        0.18 *
        scores["structure"]
    )

    # Penalty for unnatural lifting.
    final_score = (
        base_score
        -
        0.15 *
        scores["artificial_lift"]
    )

    scores["final"] = float(
        np.clip(
            final_score,
            0.0,
            1.0
        )
    )

    # --------------------------------------------------------
    # Useful statistics for debugging
    # --------------------------------------------------------

    normal_stats = scene_statistics(
        normal
    )

    candidate_stats = scene_statistics(
        candidate
    )

    scores["normal_mean"] = (
        normal_stats["mean"]
    )

    scores["candidate_mean"] = (
        candidate_stats["mean"]
    )

    scores["brightness_delta"] = (
        candidate_stats["mean"]
        -
        normal_stats["mean"]
    )

    scores["normal_shadow_ratio"] = (
        normal_stats["shadow_ratio"]
    )

    scores["candidate_shadow_ratio"] = (
        candidate_stats["shadow_ratio"]
    )

    scores["normal_highlight_ratio"] = (
        normal_stats["highlight_ratio"]
    )

    scores["candidate_highlight_ratio"] = (
        candidate_stats["highlight_ratio"]
    )

    return scores


# ============================================================
# PRINT RESULTS
# ============================================================

def print_result(
    name,
    scores
):

    print()
    print("=" * 65)
    print(name)
    print("=" * 65)

    print(
        f"Brightness        : "
        f"{scores['brightness']:.4f}"
    )

    print(
        f"Shadow            : "
        f"{scores['shadow']:.4f}"
    )

    print(
        f"Highlight         : "
        f"{scores['highlight']:.4f}"
    )

    print(
        f"Color             : "
        f"{scores['color']:.4f}"
    )

    print(
        f"Structure         : "
        f"{scores['structure']:.4f}"
    )

    print(
        f"Artificial lift   : "
        f"{scores['artificial_lift']:.4f}"
    )

    print(
        f"Normal mean       : "
        f"{scores['normal_mean']:.4f}"
    )

    print(
        f"Candidate mean    : "
        f"{scores['candidate_mean']:.4f}"
    )

    print(
        f"Brightness delta  : "
        f"{scores['brightness_delta']:+.4f}"
    )

    print(
        f"Normal shadows    : "
        f"{scores['normal_shadow_ratio']:.4f}"
    )

    print(
        f"Candidate shadows : "
        f"{scores['candidate_shadow_ratio']:.4f}"
    )

    print(
        f"Normal highlights : "
        f"{scores['normal_highlight_ratio']:.4f}"
    )

    print(
        f"Candidate highlights: "
        f"{scores['candidate_highlight_ratio']:.4f}"
    )

    print()
    print(
        f"FINAL SCORE       : "
        f"{scores['final']:.4f}"
    )


# ============================================================
# MAIN TEST
# ============================================================

if __name__ == "__main__":

    base = os.path.expanduser(
        "~/FreeMEF"
    )

    normal_path = os.path.join(
        base,
        "my_test",
        "scene005",
        "02_normal.jpg"
    )

    v33_path = os.path.join(
        base,
        "production",
        "output",
        "adaptive_fusion_v3_3_client_bright",
        "FINAL_SCENE005_CLIENT_BRIGHT.jpg"
    )

    mertens_path = os.path.join(
        base,
        "adaptive_outputs",
        "mertens_candidate_v2_scene005.jpg"
    )

    # --------------------------------------------------------
    # Check files
    # --------------------------------------------------------

    for label, path in [
        ("Normal", normal_path),
        ("V3.3", v33_path),
        ("Mertens", mertens_path)
    ]:

        if not os.path.exists(path):

            raise FileNotFoundError(
                f"{label} file not found:\n{path}"
            )

    # --------------------------------------------------------
    # Evaluate
    # --------------------------------------------------------

    v33_scores = evaluate(
        v33_path,
        normal_path
    )

    mertens_scores = evaluate(
        mertens_path,
        normal_path
    )

    print_result(
        "CANDIDATE 1 - V3.3 CLIENT BRIGHT",
        v33_scores
    )

    print_result(
        "CANDIDATE 2 - MERTENS V2",
        mertens_scores
    )

    # --------------------------------------------------------
    # Winner
    # --------------------------------------------------------

    print()
    print("=" * 65)

    if (
        v33_scores["final"]
        >
        mertens_scores["final"]
    ):

        print(
            "WINNER: V3.3 CLIENT BRIGHT"
        )

    elif (
        mertens_scores["final"]
        >
        v33_scores["final"]
    ):

        print(
            "WINNER: MERTENS V2"
        )

    else:

        print(
            "WINNER: TIE"
        )

    print("=" * 65)
